{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rosy",
  "version": "0.1.0",
  "identifier": "com.rosy.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rosy",
        "width": 960,
        "height": 620,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "maximized": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
